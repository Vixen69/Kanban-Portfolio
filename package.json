{
  "name": "portfolio-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Instrument kanban de portefeuille — re-plateformage vers la plateforme conteneurisée du client (ADR 011)",
  "workspaces": [
    "core",
    "middle",
    "front"
  ],
  "engines": {
    "node": ">=22.18.0 <24.0.0"
  },
  "scripts": {
    "start": "node scripts/dev.ts",
    "dev": "npm run -w @portfolio-kanban/front dev",
    "build": "npm run -w @portfolio-kanban/front build",
    "preview": "npm run -w @portfolio-kanban/front preview",
    "serve": "node middle/main.ts",
    "seed": "node scripts/seed.ts",
    "import": "node sync/import.ts",
    "import-design": "node scripts/import-design.ts",
    "typecheck": "tsc --noEmit && tsc -p middle/tsconfig.json && tsc -p front/tsconfig.json",
    "test": "node --test \"core/**/*.test.ts\" \"adapters/**/*.test.ts\" \"middle/**/*.test.ts\" \"front/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "conventions": "node scripts/check-conventions.ts",
    "sbom": "node scripts/sbom.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~5.9.2"
  }
}
