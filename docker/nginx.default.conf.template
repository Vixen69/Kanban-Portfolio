# Front reverse proxy (design/SECURITY: same-origin only, zero egress from the
# browser). nginx serves the static Vite build and proxies /api to the middle,
# so every API call stays same-origin. ${MIDDLE_HOST}/${MIDDLE_PORT} are filled
# by the nginx image's envsubst at container start (only defined env vars are
# substituted — $uri/$host/$remote_addr are left untouched). ADR 015.
server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Don't advertise the nginx version on responses/errors.
    server_tokens off;

    # Security headers on the DOCUMENT itself: the browser enforces CSP,
    # frame-ancestors, Referrer-Policy etc. on the page that loads and runs the
    # scripts — served here by nginx, not by the middle. These MUST stay in step
    # with SECURITY_HEADERS in middle/app.ts (same policy on /api responses); the
    # page additionally allows data: URIs for the Vite build's inlined assets
    # (fonts / small images). `always` so error responses (404…) carry them too.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()" always;

    # Match the middle's 64 KB JSON body cap at the edge (the import routes
    # below raise it to 40 MB, like the middle does).
    client_max_body_size 64k;

    # Bad networks are the norm on site (author, 2026-09-10): compress every
    # text response — the /api JSON through the proxy included — and let the
    # browser keep the hashed build assets and the fonts (below).
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

    # Vite hashes its build assets: cache them for a year, immutable. (An
    # add_header in a location replaces the server-level ones — the document
    # headers above are for the page, not for these files.)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Self-hosted fonts are not hashed: a week.
    location /fonts/ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA history fallback: unknown client routes render index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The import routes carry whole CSV exports, base64 in JSON (ADR 027):
    # the middle caps them at 40 MB, the edge must let them through. Longest
    # prefix wins, so this block takes precedence over /api/ below.
    location /api/import/ {
        client_max_body_size 40m;
        proxy_pass         http://${MIDDLE_HOST}:${MIDDLE_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_read_timeout 120s;
        proxy_request_buffering off;
    }

    # Same-origin API proxy to the middle (Express).
    location /api/ {
        proxy_pass         http://${MIDDLE_HOST}:${MIDDLE_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
