# Front reverse proxy (design/SECURITY: same-origin only, zero egress from the
# browser). nginx serves the static Vite build and proxies /api to the middle,
# so every API call stays same-origin. ${MIDDLE_HOST}/${MIDDLE_PORT} are filled
# by the nginx image's envsubst at container start (only defined env vars are
# substituted — $uri/$host/$remote_addr are left untouched). ADR 015.
server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # SPA history fallback: unknown client routes render index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin API proxy to the middle (Express).
    location /api/ {
        proxy_pass         http://${MIDDLE_HOST}:${MIDDLE_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
