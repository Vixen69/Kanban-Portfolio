# Front (React 18 + Vite) — build static assets, serve via nginx. front/ exists
# (RP2) and `npm run -w front build` is real; the remaining gap is the nginx
# conf proxying /api -> middle (same-origin), added at RP6.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY core ./core
COPY front ./front
RUN npm ci
RUN npm run --workspace front build

FROM nginx:1.27-alpine AS run
COPY --from=build /app/front/dist /usr/share/nginx/html
EXPOSE 80
