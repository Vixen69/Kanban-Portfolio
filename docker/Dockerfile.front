# Front (React 18 + Vite) — build the static bundle, serve it with nginx which
# also reverse-proxies /api to the middle (same-origin, zero egress). Node
# 22.18 to build, nginx 1.27-alpine to serve. ADR 015. Both base images are
# digest-pinned (tags move under you) so the build is reproducible.
FROM node:22.18-alpine@sha256:1b2479dd35a99687d6638f5976fd235e26c5b37e8122f786fcd5fe231d63de5b AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY core/package.json ./core/package.json
COPY middle/package.json ./middle/package.json
COPY front/package.json ./front/package.json
RUN npm ci
# The front build (tsc + vite) needs core/ (it imports the pure domain types).
COPY core ./core
COPY front ./front
RUN npm run --workspace front build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS run
# Upstream of the /api proxy — overridable (compose sets these to the service).
ENV MIDDLE_HOST=middle MIDDLE_PORT=8787
COPY docker/nginx.default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/front/dist /usr/share/nginx/html
EXPOSE 80
