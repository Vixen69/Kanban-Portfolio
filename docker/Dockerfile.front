# Front (React 18 + Vite) — build static assets, serve via nginx. SKELETON for
# RP2: front/ does not exist yet, so this image is not buildable until RP2.
# The nginx conf that proxies /api -> middle (same-origin) is added in RP2/RP6.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY core ./core
COPY front ./front
RUN npm ci
RUN npm run --workspace front build

FROM nginx:1.27-alpine AS run
COPY --from=build /app/front/dist /usr/share/nginx/html
EXPOSE 80
