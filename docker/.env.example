# Copy to docker/.env and adjust. Consumed by docker/compose.yaml.
# These are DEV credentials for the local PostgreSQL only — never real secrets.
POSTGRES_USER=kanban
POSTGRES_PASSWORD=thuglife
POSTGRES_DB=kanban
DB_PORT=5432
# Import depuis l'outil (ADR 027) : secret partagé attendu dans l'en-tête
# X-Import-Secret. Laisser vide pour désactiver les routes d'import.
KANBAN_IMPORT_SECRET=
