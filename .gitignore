dist/
.npm-offline/
*.tsbuildinfo
sbom.json
data/
# Belt-and-suspenders: never commit a real-data store, whatever path it is
# configured to (CLAUDE.md §7 — no client data crosses here). Covers the
# SQLite database + WAL sidecars and the JSONL fallback file.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.jsonl
# Local Docker dev env (credentials) — only the .example is committed.
docker/.env
# Design exports land as a zip + extracted folder; the REFERENCE that is
# versioned is design/*.jsx at the root (scripts/import-design.ts writes
# there so `git diff design/` shows the delta). The raw export is a local
# working copy, not a second source of truth.
design/*.zip
design/Portfolio kanban/
